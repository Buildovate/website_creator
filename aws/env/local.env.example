# Local disposable Postgres (in-process) and memory bucket. Not for preview or production.
APP_ENV=local
NODE_ENV=development
AUTH_MODE=dev-header
DATABASE_DRIVER=pglite
BUCKET_DRIVER=memory
AWS_REGION=us-west-1
PORT=8080
MIGRATE_ON_BOOT=1
# Optional persistence for the local database. Leave unset for an in-memory database.
# PGLITE_DATA_DIR=.data/pglite

# Same optional provider names as .env.example. Leave blank here; do not commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini
