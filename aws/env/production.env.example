# Production — Elastic Beanstalk environment website-creator-production
# Application: buildovate-website-creator-production
# Region: us-west-1. Account: 846588355042.
# Set these as EB environment properties or Secrets Manager references.
# Do not commit real passwords, API keys, or connection strings.
# Do not copy preview values into this environment.

APP_ENV=production
NODE_ENV=production
AWS_REGION=us-west-1
PORT=8080
# Apply migrations as a release step (`npm run aws:migrate`) before shifting traffic.
MIGRATE_ON_BOOT=0

AUTH_MODE=alb-oidc
# AUTH_OIDC_ISSUER=
# AUTH_MODE=cognito
# COGNITO_REGION=us-west-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# New Postgres instance for website_creator. Do not point this at preview or at a CRM Aurora database.
DATABASE_URL=postgresql://website_creator:PASSWORD@website-creator-production-postgres.example.us-west-1.rds.amazonaws.com:5432/website_creator
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=0

# Existing private bucket.
S3_BUCKET=buildovate-website-creator-production

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
