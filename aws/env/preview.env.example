# Preview (staging) — Elastic Beanstalk environment website-creator-preview
# Application: buildovate-website-creator-preview
# Region: us-west-1. Account: 846588355042.
# Set these as EB environment properties or Secrets Manager references.
# Do not commit real passwords, API keys, or connection strings.

APP_ENV=preview
NODE_ENV=production
AWS_REGION=us-west-1
PORT=8080
MIGRATE_ON_BOOT=1

# ALB + Cognito (or any OIDC provider ALB supports). Instances accept traffic only from the ALB.
AUTH_MODE=alb-oidc
# Optional exact issuer check, for example the Cognito issuer URL.
# AUTH_OIDC_ISSUER=https://cognito-idp.us-west-1.amazonaws.com/us-west-1_XXXXXXXX
# Optional Cognito/ALB logout URL. Must be http or https. Shown as Sign out in the workspace.
# AUTH_LOGOUT_URL=https://example.auth.us-west-1.amazoncognito.com/logout
# Alternative when the app verifies Cognito ID tokens itself instead of the ALB:
# AUTH_MODE=cognito
# COGNITO_REGION=us-west-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# New Postgres instance for website_creator. Do not point this at a CRM Aurora database.
# Example host name only — create website-creator-preview-postgres in us-west-1.
DATABASE_URL=postgresql://website_creator:PASSWORD@website-creator-preview-postgres.example.us-west-1.rds.amazonaws.com:5432/website_creator
PGSSLMODE=require
# RDS encryption works with the default trust store once the Amazon RDS CA is installed.
# Until that CA bundle is on the image, set this to 0 to encrypt without verifying the chain.
PGSSL_REJECT_UNAUTHORIZED=0

# Existing private bucket. Do not create a new one and do not use the production bucket.
S3_BUCKET=buildovate-website-creator-preview

# Provider secrets. Leave empty in git. Set the real values in the EB environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
