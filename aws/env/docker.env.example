# Docker Compose local stack. Not for preview or production.
#
# `docker compose up` loads this file into the app container. To set
# OPENAI_API_KEY (or any other provider secret), copy this file and edit the
# copy. The copy is gitignored:
#
#   PowerShell:  Copy-Item aws\env\docker.env.example aws\env\docker.env
#   bash:        cp aws/env/docker.env.example aws/env/docker.env
#
# Compose loads aws/env/docker.env after this example, so values in the copy
# win. Do not put real keys in this example.
#
# postgres and minio are Compose service names. They resolve inside the
# Compose network. From the host, use localhost and the published ports.

APP_ENV=local
NODE_ENV=development
AUTH_MODE=dev-header
AWS_REGION=us-west-1
PORT=8080
MIGRATE_ON_BOOT=1

# Local Compose password only. It matches POSTGRES_PASSWORD in docker-compose.yml.
DATABASE_URL=postgresql://website_creator:website_creator@postgres:5432/website_creator

# Local MinIO only. S3_ENDPOINT and the static keys are refused unless APP_ENV=local.
# They match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml.
S3_BUCKET=website-creator-local
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Optional providers. Set real values only in aws/env/docker.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
