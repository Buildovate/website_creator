{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Preview-only immutable template media. Existing private upload bucket is retained; merge the exported read grant separately.",
  "Parameters": {"PreviewBucket": {"Type": "String", "Default": "buildovate-website-creator-preview", "AllowedValues": ["buildovate-website-creator-preview"]}},
  "Resources": {
    "OriginAccess": {"Type": "AWS::CloudFront::OriginAccessControl", "Properties": {"OriginAccessControlConfig": {"Name": {"Fn::Sub": "${AWS::StackName}-preview-media"}, "OriginAccessControlOriginType": "s3", "SigningBehavior": "always", "SigningProtocol": "sigv4"}}},
    "ImmutableCache": {"Type": "AWS::CloudFront::CachePolicy", "Properties": {"CachePolicyConfig": {"Name": {"Fn::Sub": "${AWS::StackName}-immutable"}, "DefaultTTL": 31536000, "MinTTL": 0, "MaxTTL": 31536000, "ParametersInCacheKeyAndForwardedToOrigin": {"EnableAcceptEncodingGzip": true, "EnableAcceptEncodingBrotli": true, "CookiesConfig": {"CookieBehavior": "none"}, "HeadersConfig": {"HeaderBehavior": "none"}, "QueryStringsConfig": {"QueryStringBehavior": "none"}}}}},
    "PublicMediaHeaders": {"Type": "AWS::CloudFront::ResponseHeadersPolicy", "Properties": {"ResponseHeadersPolicyConfig": {"Name": {"Fn::Sub": "${AWS::StackName}-media-cors"}, "CorsConfig": {"AccessControlAllowCredentials": false, "AccessControlAllowHeaders": {"Items": ["Range"]}, "AccessControlAllowMethods": {"Items": ["GET", "HEAD", "OPTIONS"]}, "AccessControlAllowOrigins": {"Items": ["*"]}, "AccessControlExposeHeaders": {"Items": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"]}, "OriginOverride": true}}}},
    "MediaDistribution": {"Type": "AWS::CloudFront::Distribution", "Properties": {"Tags": [{"Key": "Application", "Value": "website-creator"}, {"Key": "Environment", "Value": "preview"}, {"Key": "Purpose", "Value": "template-media"}], "DistributionConfig": {"Enabled": true, "Comment": "Website Creator preview template media only", "PriceClass": "PriceClass_100", "HttpVersion": "http2and3", "Origins": [{"Id": "PreviewTemplateMedia", "DomainName": {"Fn::Sub": "${PreviewBucket}.s3.us-west-1.amazonaws.com"}, "OriginAccessControlId": {"Ref": "OriginAccess"}, "S3OriginConfig": {"OriginAccessIdentity": ""}}], "DefaultCacheBehavior": {"TargetOriginId": "PreviewTemplateMedia", "ViewerProtocolPolicy": "redirect-to-https", "AllowedMethods": ["GET", "HEAD", "OPTIONS"], "CachedMethods": ["GET", "HEAD"], "Compress": true, "CachePolicyId": {"Ref": "ImmutableCache"}, "ResponseHeadersPolicyId": {"Ref": "PublicMediaHeaders"}}, "ViewerCertificate": {"CloudFrontDefaultCertificate": true}}}}
  },
  "Outputs": {
    "TemplateMediaOrigin": {"Value": {"Fn::Sub": "https://${MediaDistribution.DomainName}"}},
    "DistributionArn": {"Value": {"Fn::Sub": "arn:aws:cloudfront::${AWS::AccountId}:distribution/${MediaDistribution}"}},
    "BucketReadGrant": {"Description": "Merge this statement into the EXISTING preview bucket policy; never overwrite its other statements.", "Value": {"Fn::Sub": "{\"Sid\":\"WebsiteCreatorPreviewTemplateMedia\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"cloudfront.amazonaws.com\"},\"Action\":\"s3:GetObject\",\"Resource\":\"arn:aws:s3:::${PreviewBucket}/assets/template-media/*\",\"Condition\":{\"StringEquals\":{\"AWS:SourceArn\":\"arn:aws:cloudfront::${AWS::AccountId}:distribution/${MediaDistribution}\"}}}"}}
  }
}
