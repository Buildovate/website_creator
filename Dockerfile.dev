# Local edit image. Not used by Elastic Beanstalk.
# `docker compose up --build` uses Dockerfile. This file is only selected by
# docker-compose.dev.yml.
FROM node:22-bookworm-slim
WORKDIR /app
ENV PORT=8080
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build
EXPOSE 8080
CMD ["sh", "-c", "npm run build && exec node src/aws/server.js"]
