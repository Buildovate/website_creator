{
  "name": "buildovate-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "db:generate": "drizzle-kit generate",
    "dev": "vite",
    "aws:migrate": "node src/aws/migrate.js",
    "aws:start": "node src/aws/server.js",
    "test:aws": "node tests/aws-adapter.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.5",
    "esbuild": "0.25.9",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.10"
  }
}
