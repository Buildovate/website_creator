# Optional providers. Store real values only as server secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
# Zoom Server-to-Server OAuth, Buildovate's internal calendar only.
# Required scope: meeting:write:meeting:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
# Campaign delivery remains held until a delivery worker is activated.
# Chat alerts use Twilio immediately after a contractor verifies and enables their phone.
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
